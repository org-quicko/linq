// linq — entity relationship diagram
//
// Paste this file into https://dbdiagram.io/d (or `npx @dbml/cli`) to render it.
// Generated by hand from apps/server/src/db/schema.ts; that file and the
// migrations under apps/server/drizzle/ remain the source of truth.

Project linq {
  database_type: 'PostgreSQL'
  Note: '''
    A self-hosted URL shortener and dynamic-link service.

    Eight tables in three groups: who acts (users, api_keys), what is served
    (domains, links, rules), and what happened (visits, and the two rollups
    derived from it).

    Requires PostgreSQL 15+: visit_days and visit_counts use
    UNIQUE NULLS NOT DISTINCT.
  '''
}

// ── Enums ────────────────────────────────────────────────────────────────────

Enum role {
  viewer  [note: 'Reads everything.']
  author  [note: 'Also creates and manages its own links.']
  manager [note: 'Also manages any link.']
  admin   [note: 'Also manages domains, users and keys, and may purge.']
}

Enum user_status {
  active
  disabled [note: 'Every key of a disabled user fails authentication.']
}

Enum resource_status {
  active
  archived [note: 'Soft-deleted. Keeps its rows and, for a link, its slug.']
}

Enum platform {
  android
  ios
  desktop [note: 'Also the fallback for an unknown or absent user agent.']
}

Enum visit_dimension {
  total       [note: 'Every visit of the day. What the `day` grouping reads.']
  platform
  referer
  destination
  slug
}

// ── Identity ─────────────────────────────────────────────────────────────────

Table users {
  id         uuid        [pk, note: 'UUIDv7, so ids sort by creation time']
  name       text        [not null]
  email      text        [unique]
  role       role        [not null]
  status     user_status [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Owners and principals. Users never log in; they act through api keys.'
}

Table api_keys {
  id         uuid        [pk]
  user_id    uuid        [not null]
  label      text        [not null]
  key_hash   text        [not null, unique, note: 'sha256 of the secret; the secret itself is shown once and never stored']
  prefix     text        [not null, note: 'First characters of the key, so it is recognisable in a list']
  expires_at timestamptz [note: 'Null never expires']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id [name: 'api_keys_user_id_idx']
  }

  Note: 'Revoking a key deletes the row. See docs/adr/0003 for what is logged.'
}

// ── Routing ──────────────────────────────────────────────────────────────────

Table domains {
  id           uuid            [pk]
  host         text            [not null, unique, note: 'Lowercased, optionally carrying a port']
  fallback_url text            [note: 'Where orphan visits go. Null means 404.']
  status       resource_status [not null, default: 'active']
  created_at   timestamptz     [not null, default: `now()`]
  updated_at   timestamptz     [not null, default: `now()`]
}

Table links {
  id            uuid            [pk]
  domain_id     uuid            [not null, note: 'Immutable. ON DELETE restrict: a domain cannot be purged while any link row points at it.']
  slug          text            [not null, note: 'Immutable, and never released except by a purge']
  destination   text            [not null]
  name          text
  tags          "text[]"        [not null, default: `'{}'::text[]`]
  forward_query boolean         [not null, default: true, note: 'Merge the incoming query string over the destination']
  status        resource_status [not null, default: 'active']
  owner_id      uuid            [not null]
  created_at    timestamptz     [not null, default: `now()`]
  updated_at    timestamptz     [not null, default: `now()`]

  Indexes {
    (domain_id, slug) [unique, name: 'links_domain_slug_key']
    owner_id          [name: 'links_owner_id_idx']
    status            [name: 'links_status_idx']
    tags              [type: gin, name: 'links_tags_idx']
  }

  Note: '''
    One short link: a slug on a domain, owned by a user.

    Archiving keeps the row so a dead link cannot be hijacked by a new one;
    only a purge releases the slug. See docs/adr/0002.
  '''
}

Table rules {
  id          uuid    [pk]
  link_id     uuid    [not null]
  position    integer [not null, note: 'Server-owned. Lowest matching position wins.']
  destination text    [not null]
  conditions  jsonb   [not null, note: 'Condition[]: platform | query_param. ANDed; at most 10, and never empty.']

  Indexes {
    (link_id, position) [unique, name: 'rules_link_position_key']
  }

  Note: 'Ordered alternate destinations. At most 50 per link.'
}

// ── Analytics ────────────────────────────────────────────────────────────────

Table visits {
  id             uuid        [pk, note: 'UUIDv7, so it breaks ties in the order visits happened']
  link_id        uuid        [note: 'Null is an orphan visit. ON DELETE set null, so purging a link keeps its history and loses its attribution.']
  domain_id      uuid        [not null]
  slug_requested text        [not null, note: 'What the caller asked for, empty for the root path']
  occurred_at    timestamptz [not null, default: `now()`]
  is_bot         boolean     [not null, note: 'Decided once at ingest; no user agent at all counts as a bot']
  platform       platform    [not null]
  user_agent     text
  referer        text
  destination    text        [note: 'The URL actually chosen, after rules and query merging']
  query          jsonb       [note: 'Record<string, string[]> of the incoming query, before any merging']

  Indexes {
    (link_id, occurred_at)   [name: 'visits_link_occurred_idx', note: 'occurred_at DESC']
    (domain_id, occurred_at) [name: 'visits_domain_occurred_idx', note: 'occurred_at DESC']
    occurred_at              [name: 'visits_orphan_occurred_idx', note: 'DESC, partial: WHERE link_id IS NULL']
  }

  Note: '''
    One row per request. The detail table, and the only source of truth for
    analytics — both rollups below are derived from it by trigger.

    Inserted fire-and-forget: a visit must never delay a redirect.
  '''
}

Table visit_days {
  day       date            [not null, note: 'Cut in UTC, so a report never shifts with the session timezone']
  domain_id uuid            [not null]
  link_id   uuid            [note: 'Null is the orphan scope. No foreign key — see the table note.']
  dimension visit_dimension [not null]
  value     text            [not null, note: 'Empty string where the dimension was not recorded, never a word a real value could collide with']
  is_bot    boolean         [not null]
  count     bigint          [not null, default: 0]

  Indexes {
    (day, domain_id, link_id, dimension, value, is_bot) [unique, name: 'visit_days_key', note: 'NULLS NOT DISTINCT, so the orphan scope upserts onto one row']
    (link_id, dimension, day)                           [name: 'visit_days_link_idx']
    (domain_id, dimension, day)                         [name: 'visit_days_domain_idx']
  }

  Note: '''
    Pre-counted visits, one row per day, scope, dimension value and bot flag.
    One table serves every grouping the stats API offers. See docs/adr/0007.

    Derived data: only the triggers in 0005_visit_rollup_triggers.sql write
    here. An AFTER INSERT trigger on visits increments seven rows per visit.

    link_id deliberately carries NO foreign key. Purging a link merges these
    rows into the orphan scope, and an ON DELETE SET NULL would pre-empt that
    merge and collide on the unique constraint. domain_id does cascade, which
    is what makes purging a domain destroy its rollups with its visits.
  '''
}

Table visit_counts {
  domain_id     uuid        [not null]
  link_id       uuid        [note: 'Null is the orphan scope, one row per domain. No foreign key — see the table note.']
  human         bigint      [not null, default: 0]
  bot           bigint      [not null, default: 0]
  last_visit_at timestamptz

  Indexes {
    (domain_id, link_id) [unique, name: 'visit_counts_key', note: 'NULLS NOT DISTINCT']
    link_id              [name: 'visit_counts_link_idx', note: 'The join every link response makes']
  }

  Note: '''
    All-time totals per scope: one row per link, plus one per domain for its
    orphans. What every link list and overview tile reads instead of
    aggregating the whole visits table.

    Derived data, and link_id carries no foreign key, for the same reasons as
    visit_days above.
  '''
}

// ── Relationships ────────────────────────────────────────────────────────────

Ref: api_keys.user_id > users.id [delete: cascade]

Ref: links.domain_id > domains.id [delete: restrict]
Ref: links.owner_id  > users.id   [delete: restrict]

Ref: rules.link_id > links.id [delete: cascade]

Ref: visits.link_id   > links.id   [delete: set null]
Ref: visits.domain_id > domains.id [delete: cascade]

Ref: visit_days.domain_id   > domains.id [delete: cascade]
Ref: visit_counts.domain_id > domains.id [delete: cascade]

// visit_days.link_id and visit_counts.link_id point at links.id logically but
// carry no constraint, so no Ref is declared for them — the diagram shows what
// the database actually enforces. The table notes explain why.

// ── Grouping ─────────────────────────────────────────────────────────────────

TableGroup identity [color: #4f6d7a] {
  users
  api_keys
}

TableGroup routing [color: #5c8001] {
  domains
  links
  rules
}

TableGroup analytics [color: #a14a3a] {
  visits
  visit_days
  visit_counts
}
