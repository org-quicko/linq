{
  "name": "linq",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @linq/server dev",
    "start": "bun --filter @linq/server start",
    "build:admin": "bun --filter @linq/admin build",
    "test": "bun test apps/server/test",
    "typecheck": "tsc -b --force",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "bun --filter @linq/server db:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.3"
  }
}
