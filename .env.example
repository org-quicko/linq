# Postgres runs outside the linq image. Required.
DATABASE_URL=postgres://linq:linq@localhost:5432/linq

# Where the redirect cache lives: memory | redis | none. Left unset it follows
# LINQ_REDIS_URL below — a URL selects redis, nothing at all selects memory.
# See docs/adr/0009 for what the two differ in.
#
#   memory  an LRU inside the linq process. Nothing else to run.
#   redis   a shared store. Reachable by every linq process that points at it.
#   none    no caching; every redirect reads Postgres.
#
# LINQ_CACHE_BACKEND=memory

# Set this and Redis becomes the cache — and has to be running, or the server
# exits on boot. A Redis that goes down *later* degrades to Postgres rather than
# failing requests.
# LINQ_REDIS_URL=redis://localhost:6379

# Seconds a cached lookup survives, on whichever backend — five minutes by
# default. Only a backstop for an invalidation that was missed: every create,
# update, archive and purge clears its own entry outright.
#
LINQ_CACHE_TTL=300

# Seconds between sweeps that physically remove expired entries from the
# `memory` backend, from 1 to 3600. Expiry is still exact on read; Redis ignores
# this setting.
# LINQ_CACHE_SWEEP_INTERVAL=60

# How many entries the `memory` backend holds before evicting the least recently
# used. Entries, not bytes — the memory this implies depends on what is cached.
# Redis ignores it: a keyspace is capped with `maxmemory` in redis.conf instead.
# LINQ_CACHE_MAX_ENTRIES=10000

# HTTP port for redirects and the REST API, and for the Client UI when this server
# serves the built export. The UI can also be deployed on its own; see the README.
LINQ_PORT=3000

# Client UI mount for local builds and the server process. Dockerfile.full does
# not read this file: pass the same value explicitly as its
# LINQ_CLIENT_BASE_PATH build argument and rebuild the image when changing it.
# Must start with /, use lowercase path segments, and have no trailing slash.
LINQ_CLIENT_BASE_PATH=/home

# Port for the Client UI development server (`bun run dev:client`) and the
# published host port in docker-compose-examples/10-client-only.yml.
# The combined Docker image serves its UI on LINQ_PORT instead.
LINQ_CLIENT_PORT=3001

# Seeds the first domain row when the domains table is empty.
LINQ_DEFAULT_DOMAIN=localhost:${LINQ_PORT}

# Where the log file is stored.
LINQ_DATA_DIR=./data

# Length of generated random slugs.
LINQ_SLUG_LENGTH=6

# trace|debug|info|warn|error|fatal|silent. debug adds request params, query
# *keys* and span input/output. Client IPs are never logged; see docs/adr/0003.
LINQ_LOG_LEVEL=info

# NDJSON log file. Defaults to $LINQ_DATA_DIR/logs/linq.log; set empty for stdout only.
# LINQ_LOG_FILE=

# Rotation. Disk used is at most LINQ_LOG_MAX_SIZE x (LINQ_LOG_RETAIN + 1), which
# is the whole of what the data volume holds.
LINQ_LOG_MAX_SIZE=20m
LINQ_LOG_RETAIN=5

# Only used by the integration test suite.
# TEST_DATABASE_URL=postgres://linq:linq@localhost:5432/linq_test

# Caddy's admin API. Setting this is what turns on domain sync: every domain
# create, patch, archive and purge is pushed to Caddy as its own route, so
# linq never has to be told a domain twice. Left unset, nothing is synced
# anywhere and linq behaves exactly as it does today. See docker-compose-examples/.
# LINQ_CADDY_ADMIN_URL=http://caddy:2019

# Where Caddy reverse-proxies a matched domain to. Required once
# LINQ_CADDY_ADMIN_URL is set.
# LINQ_CADDY_UPSTREAM=linq:3000
