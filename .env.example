# Postgres runs outside the linq image. Required.
DATABASE_URL=postgres://linq:linq@localhost:5432/linq

# HTTP port for redirects, REST API and the admin UI.
LINQ_PORT=3000

# Seeds the first domain row when the domains table is empty.
LINQ_DEFAULT_DOMAIN=localhost:3000

# Admin API key minted on first boot. Generated and printed once if left unset.
# LINQ_INITIAL_API_KEY=linq_replace_me

# Downloads the DB-IP Country Lite database at boot (no account, no key). Set
# false on an install with restricted egress; clicks then have no country. This
# is the master switch and wins over both settings below.
LINQ_GEO_ENABLED=true

# Read this database instead of downloading one. linq never fetches it and never
# expires it, so keeping it current is yours to do. See docs/adr/0005.
# LINQ_GEO_DB_PATH=/geo/dbip-country-lite.mmdb

# Where linq's own download lands. Defaults to $LINQ_DATA_DIR; the Docker image
# points it at /geo so the data volume holds only the log file.
# LINQ_GEO_DIR=./data

# Where the log file is stored.
LINQ_DATA_DIR=./data

# Length of generated random slugs.
LINQ_SLUG_LENGTH=6

# Read the client IP from X-Forwarded-For (set false when linq is exposed directly).
LINQ_TRUST_PROXY=true

# trace|debug|info|warn|error|fatal|silent. debug adds request params, query
# *keys* and span input/output. Client IPs are never logged; see docs/adr/0003.
LINQ_LOG_LEVEL=info

# NDJSON log file. Defaults to $LINQ_DATA_DIR/logs/linq.log; set empty for stdout only.
# LINQ_LOG_FILE=

# Rotation. Disk used is at most LINQ_LOG_MAX_SIZE x (LINQ_LOG_RETAIN + 1), which
# is the whole of what the data volume holds.
LINQ_LOG_MAX_SIZE=20m
LINQ_LOG_RETAIN=5

# Only used by the integration test suite.
# TEST_DATABASE_URL=postgres://linq:linq@localhost:5432/linq_test
