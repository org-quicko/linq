  "keyFeatures": [
    "URL shortener with custom or random slugs",
    "Dynamic link routing with platform and query-param conditions",
    "Link tree pages (hosted social-media-style profile link pages)",
    "QR code generation with custom styling per link",
    "Per-link visit analytics with human/bot detection",
    "API key authentication with viewer/editor/admin roles",
    "Automatic HTTPS via Caddy integration for custom domains",
    "In-process LRU or Redis redirect cache",
    "Static Next.js client UI deployable standalone or served by the API server",
    "Open Graph preview pages for crawlers",
    "Privacy-first: no client IPs stored anywhere"
  ],
